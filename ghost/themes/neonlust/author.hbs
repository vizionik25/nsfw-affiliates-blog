{{!< default}}

{{#author}}
<header class="author-header">
    <div class="container">
        {{#if profile_image}}
            <img class="author-header__avatar" src="{{profile_image}}" alt="{{name}}" />
        {{/if}}
        <h1>{{name}}</h1>
        {{#if bio}}
            <p class="author-header__bio">{{bio}}</p>
        {{/if}}
        {{#if location}}
            <span class="author-header__location">📍 {{location}}</span>
        {{/if}}
        {{#if website}}
            <a class="author-header__website" href="{{website}}" target="_blank" rel="noopener noreferrer">{{website}}</a>
        {{/if}}
        {{#if twitter}}
            <a href="{{twitter}}" class="btn btn--secondary" target="_blank" rel="noopener">Twitter</a>
        {{/if}}
        {{#if facebook}}
            <a href="{{facebook}}" class="btn btn--secondary" target="_blank" rel="noopener">Facebook</a>
        {{/if}}
        <div class="author-header__count">{{plural ../pagination.total empty="No posts" singular="% post" plural="% posts"}}</div>
    </div>
</header>
{{/author}}

<section class="section">
    <div class="container">
        <div class="grid grid--posts">
            {{#foreach posts}}
                {{> post-card}}
            {{/foreach}}
        </div>

        {{#if pagination.pages}}
            <nav class="pagination">
                {{#if pagination.prev}}
                    <a class="pagination__prev" href="{{page_url pagination.prev}}">&larr; Newer Posts</a>
                {{/if}}
                <span class="pagination__info">Page {{pagination.page}} of {{pagination.pages}}</span>
                {{#if pagination.next}}
                    <a class="pagination__next" href="{{page_url pagination.next}}">Older Posts &rarr;</a>
                {{/if}}
            </nav>
        {{/if}}
    </div>
</section>
