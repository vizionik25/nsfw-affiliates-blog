{{!< default}}

<section class="error-page">
    <div class="container">
        <div class="error-page__code">{{statusCode}}</div>
        <h2>{{message}}</h2>
        <p>The page you're looking for has vanished into the void. Let's get you back on track.</p>
        <p class="text-muted">Try <button class="btn-link" data-ghost-search style="background: none; border: none; color: var(--color-accent); cursor: pointer; text-decoration: underline; padding: 0; font: inherit;">searching</button> for what you need, or head back to the homepage.</p>
        <a class="btn btn--primary" href="{{@site.url}}">Back to Homepage</a>
    </div>
</section>
