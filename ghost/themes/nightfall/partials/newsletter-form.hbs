<div class="newsletter">
  <div class="newsletter__card">
    <h2 class="text-gradient">Stay in the Loop</h2>
    <p>Get the latest reviews, exclusive deals, and insider tips delivered to your inbox. No spam, ever.</p>
    <form class="newsletter__form" data-members-form="subscribe">
      <input class="newsletter__input" type="email" name="email" placeholder="Enter your email..." required aria-label="Email address" autocomplete="email">
      <button class="btn btn--primary" type="submit">Subscribe</button>
    </form>
    <p class="newsletter__success">🎉 Welcome aboard! Check your inbox to confirm.</p>
    <p class="newsletter__error">Something went wrong. Please try again.</p>
  </div>
</div>
