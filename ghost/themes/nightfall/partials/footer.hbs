<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="{{@site.url}}" class="navbar__logo" style="display:inline-block; margin-bottom: var(--space-md);">
          <span class="text-gradient">{{@site.title}}</span>
        </a>
        {{#if @site.description}}<p>{{@site.description}}</p>{{/if}}
        <div class="footer__social">
          {{#if @site.facebook}}
            <a href="https://www.facebook.com/{{@site.facebook}}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {{/if}}
          {{#if @site.twitter}}
            <a href="https://twitter.com/{{@site.twitter}}" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          {{/if}}
        </div>
      </div>
      <div class="footer__col">
        <h3 class="footer__heading">Navigate</h3>
        <div class="footer__links">
          {{#foreach navigation}}<a href="{{url}}">{{label}}</a>{{/foreach}}
        </div>
      </div>
      <div class="footer__col">
        <h3 class="footer__heading">Legal</h3>
        <div class="footer__links">
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
          <a href="/dmca/">DMCA</a>
          <a href="/disclaimer/">Disclaimer</a>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <p>&copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved.</p>
    </div>
    <p class="footer__disclaimer">⚠️ This website contains age-restricted content. By using this site, you confirm you are 18 years of age or older.</p>
  </div>
</footer>
