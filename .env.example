# .env.example — Copy to .env and fill in your values
NODE_ENV=production
SITE_URL=https://yourdomain.com

# Database Configurations
MYSQL_HOST=db
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=change_me_ghost_password_here
MYSQL_ROOT_PASSWORD=change_me_root_password_here

# Mail / SMTP Configurations
# Note: Set MAIL_SECURE to false for port 587 (STARTTLS) or true for port 465 (SSL)
MAIL_FROM="NeonLust Blog <noreply@yourdomain.com>"
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=postmaster@yourdomain.com
MAIL_PASS=your_smtp_password_here
